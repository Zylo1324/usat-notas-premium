{
  "name": "usat-notas-premium",
  "version": "1.0.0",
  "description": "Calculadora premium de notas USAT con Next y Electron.",
  "author": "Zylo1324",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build:web": "next build",
    "build:exe": "npm run build:web && electron-builder --win portable",
    "start:electron": "npm run build:web && electron .",
    "lint": "next lint"
  },
  "dependencies": {
    "firebase": "^12.7.0",
    "framer-motion": "^12.35.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "pe.usat.calculadora.notas",
    "productName": "Calculadora Notas USAT",
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../scripts",
        "to": "scripts"
      },
      {
        "from": "../data",
        "to": "data"
      },
      {
        "from": "../grade_calculator_app/course_models.json",
        "to": "course_models.json"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "CalculadoraNotasUSAT-Premium.exe"
    }
  }
}
